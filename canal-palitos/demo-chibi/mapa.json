 "narracion": [
  {
   "desde": 0.3,
   "hasta": 3.2,
   "texto": "En 1835, México llegaba hasta aquí."
  },
  {
   "desde": 3.3,
   "hasta": 6.4,
   "texto": "Texas, California, Nuevo México… todo era mexicano."
  },
  {
   "desde": 6.6,
   "hasta": 9.4,
   "texto": "Pero en 1836, Texas se independizó…"
  },
  {
   "desde": 9.6,
   "hasta": 12.6,
   "texto": "y en 1845, Estados Unidos se la anexó."
  },
  {
   "desde": 12.8,
   "hasta": 16.4,
   "texto": "El presidente Polk quería más: California."
  },
  {
   "desde": 16.6,
   "hasta": 18.6,
   "texto": "En 1846 estalló la guerra."
  },
  {
   "desde": 18.7,
   "hasta": 21.4,
   "texto": "El ejército estadounidense llegó hasta la Ciudad de México."
  },
  {
   "desde": 21.6,
   "hasta": 24.6,
   "texto": "En 1848, México firmó la paz… por 15 millones de dólares."
  },
  {
   "desde": 24.7,
   "hasta": 27.4,
   "texto": "Y perdió más de la mitad de su territorio."
  },
  {
   "desde": 27.6,
   "hasta": 31.4,
   "texto": "Lo peor: 9 días antes, alguien había encontrado oro en California."
  }
 ],
