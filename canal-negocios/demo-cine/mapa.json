  {
   "desde": 0.0,
   "hasta": 2.09,
   "texto": "Todo en esta tienda cuesta un dólar con veinticinco."
  },
  {
   "desde": 3.01,
   "hasta": 5.98,
   "texto": "Entonces… ¿cómo gana millones vendiendo cosas tan baratas?"
  },
  {
   "desde": 6.82,
   "hasta": 8.05,
   "texto": "Empecemos por el tamaño."
  },
  {
   "desde": 8.81,
   "hasta": 12.04,
   "texto": "Dollar Tree tiene más de 9,200 tiendas en Estados Unidos y Canadá."
  },
  {
   "desde": 12.75,
   "hasta": 16.57,
   "texto": "Y en 2025 vendió 19,400 millones de dólares."
  },
  {
   "desde": 17.45,
   "hasta": 19.77,
   "texto": "Pero el truco está en cuánto paga por cada cosa."
  },
  {
   "desde": 20.38,
   "hasta": 21.8,
   "texto": "De cada dólar con veinticinco,"
  },
  {
   "desde": 22.29,
   "hasta": 26.08,
   "texto": "unos 80 centavos se van en comprar el producto y ponerlo en la tienda."
  },
  {
   "desde": 26.71,
   "hasta": 29.76,
   "texto": "Le quedan unos 45 centavos para sueldos, gastos… y ganancia."
  },
  {
   "desde": 30.61,
   "hasta": 31.18,
   "texto": "Parece poco."
  },
  {
   "desde": 31.86,
   "hasta": 34.4,
   "texto": "Pero en un año, eso sumó más de 7,000 millones de dólares."
  },
  {
   "desde": 35.33,
   "hasta": 36.82,
   "texto": "¿Qué negocio quieres que expliquemos después?"
  },
  {
   "desde": 37.46,
