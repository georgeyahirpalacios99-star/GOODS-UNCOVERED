 "narracion": [
  {
   "desde": 0.75,
   "hasta": 5.05,
   "texto": "En Ecuador hay un lugar donde llueve veinticinco veces más que en otro."
  },
  {
   "desde": 5.31,
   "hasta": 8.19,
   "texto": "Y están a solo trescientos cuarenta kilómetros."
  },
  {
   "desde": 8.45,
   "hasta": 9.1,
   "texto": "La razón:"
  },
  {
   "desde": 9.36,
   "hasta": 12.25,
   "texto": "Ecuador no tiene una sola temporada de lluvias."
  },
  {
   "desde": 12.51,
   "hasta": 15.1,
   "texto": "Cada región llueve por un motivo distinto."
  },
  {
   "desde": 15.36,
   "hasta": 18.65,
   "texto": "En la Amazonía, el aire húmedo choca contra los Andes…"
  },
  {
   "desde": 18.91,
   "hasta": 19.97,
   "texto": "sube, se enfría…"
  },
  {
   "desde": 20.23,
   "hasta": 21.18,
   "texto": "y se descarga."
  },
  {
   "desde": 21.44,
   "hasta": 24.32,
   "texto": "En Puyo caen unos cuatro mil milímetros al año."
  },
  {
   "desde": 24.58,
   "hasta": 26.47,
   "texto": "En la Costa pasa lo contrario:"
  },
  {
   "desde": 26.73,
   "hasta": 30.08,
   "texto": "la corriente fría de Humboldt no deja crecer las nubes."
  },
  {
   "desde": 30.34,
   "hasta": 33.23,
   "texto": "Salinas recibe apenas ciento veinte milímetros,"
  },
  {
   "desde": 33.49,
   "hasta": 35.43,
   "texto": "casi todos entre enero y abril."
  },
  {
   "desde": 35.69,
   "hasta": 38.81,
   "texto": "Y en la Sierra hay dos temporadas de lluvia al año."
  },
  {
   "desde": 39.07,
   "hasta": 41.9,
   "texto": "Pero cada pocos años el mar cambia las reglas."
  },
  {
   "desde": 42.16,
   "hasta": 44.33,
   "texto": "Los pescadores lo llamaron El Niño,"
  },
  {
   "desde": 44.59,
   "hasta": 46.6,
   "texto": "porque llegaba cerca de Navidad."
  },
  {
   "desde": 46.86,
   "hasta": 49.74,
   "texto": "El agua se calienta y empieza a fabricar nubes."
  },
  {
   "desde": 50.0,
   "hasta": 53.0,
   "texto": "Hoy el mar de Ecuador llegó a veintinueve grados:"
  },
  {
   "desde": 53.26,
   "hasta": 55.91,
   "texto": "más que en mil novecientos noventa y siete."
  },
  {
   "desde": 56.17,
   "hasta": 58.18,
   "texto": "¿En tu ciudad cuándo llueve más?"
  },
  {
   "desde": 58.44,
   "hasta": 60.56,
   "texto": "Escríbelo y lo ponemos en el mapa."
  }
 ],
