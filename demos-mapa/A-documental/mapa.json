 "narracion": [
  {
   "desde": 0.5,
   "hasta": 5.3,
   "texto": "En 1735 nadie sabía qué forma tenía la Tierra."
  },
  {
   "desde": 5.6,
   "hasta": 10.9,
   "texto": "Newton decía que estaba achatada en los polos. Los Cassini, en París, que era alargada."
  },
  {
   "desde": 11.2,
   "hasta": 15.4,
   "texto": "Francia mandó una expedición a medir el planeta justo en la línea ecuatorial."
  },
  {
   "desde": 15.6,
   "hasta": 21.0,
   "texto": "Cruzaron por Panamá y desembarcaron en Manta en marzo de 1736."
  },
  {
   "desde": 21.5,
   "hasta": 24.8,
   "texto": "Pasaron ocho años midiendo entre volcanes."
  },
  {
   "desde": 24.9,
   "hasta": 28.0,
   "texto": "Y demostraron que Newton tenía razón."
  },
  {
   "desde": 30.6,
   "hasta": 33.8,
   "texto": "Pero el monumento de la Mitad del Mundo"
  },
  {
   "desde": 33.9,
   "hasta": 37.2,
   "texto": "está unos 240 metros al sur de la línea."
  }
 ],
